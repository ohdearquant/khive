{
  "name": "@khive/cli",
  "version": "0.1.0",
  "description": "khive — research knowledge graph CLI",
  "license": "Apache-2.0",
  "tasks": {
    "dev": "deno run --allow-all cli/main.ts",
    "test": "deno test --allow-all cli/",
    "check": "deno check cli/main.ts",
    "fmt": "deno fmt cli/",
    "lint": "deno lint cli/",
    "compile": "deno compile --allow-all --output dist/khive cli/main.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  }
}
